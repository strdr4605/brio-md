{
  "name": "brio-md",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "build": "npm run build:landing && npm run build:portal && npm run build:learn",
    "build:landing": "cd apps/landing && npm run build",
    "build:portal": "cd apps/portal && npm run build",
    "build:learn": "cd apps/learn && npm run build",
    "studio": "cd packages/db && npx drizzle-kit studio",
    "deploy": "kamal deploy",
    "lint": "oxlint -c oxlintrc.json .",
    "format": "prettier --write . --list-different",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.30.0",
    "oxlint": "^1.66.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1"
  }
}
