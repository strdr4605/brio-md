{
  "name": "brio-md",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up",
    "dev:landing": "cd apps/landing && npm run dev",
    "dev:portal": "cd apps/portal && npm run dev",
    "dev:learn": "cd apps/learn && npm run dev",
    "build": "npm run build:landing && npm run build:portal && npm run build:learn",
    "build:landing": "cd apps/landing && npm run build",
    "build:portal": "cd apps/portal && npm run build",
    "build:learn": "cd apps/learn && npm run build",
    "studio": "cd packages/db && npx drizzle-kit studio",
    "deploy": "kamal deploy"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.30.0",
    "tailwindcss": "^3.4.1"
  }
}