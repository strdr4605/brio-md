# =============================================================================
# BRIO.MD - SUBSCRIPTION BILLING CRON SCHEDULE
# =============================================================================
# Запуск 1-го числа каждого месяца в 02:00 ночи (UTC)
#
# Что делает:
# 1. Сканирует всех активных студентов с абонементами (subscription_monthly).
# 2. Выставляет недостающие счета в статус "Ciornă" (Draft).
# 3. Переводит просроченные неоплаченные счета в статус "Restantă" (Overdue).
#
# -----------------------------------------------------------------------------
# Вариант 1: Прямой запуск через Node / TSX на сервере
0 0 1 * * cd /var/www/brio-md/apps/portal && npm run cron:subscriptions -- --auto-create >> /var/log/brio-cron.log 2>&1

# Вариант 2: Запуск через Docker-контейнер (Kamal / Docker Compose)
0 2 1 * * docker exec -w /app/apps/portal brio-md-portal-1 npx tsx src/scripts/cronSubscriptions.ts --auto-create >> /var/log/brio-cron.log 2>&1

# Вариант 3: Вызов через HTTP Webhook эндпоинт (cron-job.org / Cloudflare Workers / curl)
0 2 1 * * curl -s -X POST "https://in.brio.md/api/cron/check-subscriptions?autoCreateMissing=true" -H "Authorization: Bearer $CRON_SECRET" >> /var/log/brio-cron-api.log 2>&1
