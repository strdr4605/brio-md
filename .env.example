# Database
DATABASE_URL="postgres://brio:briopassword@localhost:5432/brio_md"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3002"

# Tasmota (Front Door)
TASMOTA_IP="192.168.1.100"
TASMOTA_PORT="1883"
TASMOTA_USER="admin"
TASMOTA_PASSWORD="yourpassword"

# Object Storage (MinIO local or Cloudflare R2 / AWS S3 production)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadminpassword"
S3_BUCKET_NAME="brio-media"
S3_PUBLIC_URL="http://localhost:9000/brio-media"